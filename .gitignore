# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Project artefacts
.cache/
outputs/
*.html

# docs/ is private by default: working notes live here and are not part of the
# artefact, so only what is explicitly published ships. Naming an ignored file
# would defeat the point of not shipping it.
docs/*.md
!docs/BLUEPRINT.md

# Notebooks
.ipynb_checkpoints/

# OS / editors
.DS_Store
.idea/
.vscode/

# CI artefacts downloaded for debugging
logs_*.zip

# Credentials — nothing here today, and this is how it stays that way.
# A paid market-data provider is the obvious future reason to hold a key, and
# the moment to add these rules is before that key exists, not after.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets.json
credentials.json
.netrc
*.credentials
